DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_application_client_id_here
DISCORD_GUILD_ID=

POLL_INTERVAL_MS=600000
LIFECYCLE_INTERVAL_MS=60000

# GGScore public API — get a key from https://ggscore.net/pricing
# Free: 3/day · Premium (hosted public bot): 100/day · Black: unlimited (set a high local cap)
GGSCORE_API_KEY=your_ggscore_api_key_here
GGSCORE_BASE_URL=https://ggscore.net
GGSCORE_DAILY_LIMIT=3
GGSCORE_SYNC_ON_START=false
# Min ms between heavy syncs (upcoming|full), including after a restart. 0 = off.
GGSCORE_SYNC_COOLDOWN_MS=3600000
# Upcoming pages per heavy sync (1 request each). Self-host default 3. Hosted Premium: 10. Max 20.
GGSCORE_MAX_UPCOMING_PAGES=3
# Heavy syncs stop when this many calls (or fewer) remain, so /sync results still works.
# Self-host default 1. Hosted Premium: 10.
GGSCORE_RESERVE_CALLS=1
# Manual /sync upcoming|full and empty-cache /setup per UTC day. Scheduled syncs do not count.
# Self-host default 3. Hosted Premium: 2.
GGSCORE_MANUAL_HEAVY_SYNCS_PER_DAY=3
# UTC hours for automatic full sync, comma-separated. Hosted Premium example: 6,18
# Leave empty for self-host Free so you do not burn the 3/day quota automatically.
GGSCORE_SCHEDULED_SYNC_HOURS=

# Developer-only commands (/demo, /test). Leave blank on a public hosted bot so invitees never see them.
# Set DEV_GUILD_ID to your personal test server (can match DISCORD_GUILD_ID).
# Optional: comma-separated Discord user IDs allowed to run them (empty = anyone in that guild).
DEV_GUILD_ID=
DEV_USER_IDS=
