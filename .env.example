DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_application_client_id_here
DISCORD_GUILD_ID=

# Data source: hltv | ggscore | both
# - hltv: scrape HLTV (original behavior)
# - ggscore: use cached GGScore data for matches (no live API calls except /ggscore-sync)
# - both: HLTV for tournaments, GGScore cache for matches
DATA_PROVIDER=ggscore

POLL_INTERVAL_MS=600000

# GGScore public API — get key from https://ggscore.net cabinet
GGSCORE_API_KEY=your_ggscore_api_key_here
GGSCORE_BASE_URL=https://ggscore.net
GGSCORE_DAILY_LIMIT=3
GGSCORE_SYNC_ON_START=false
